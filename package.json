{
  "name": "file-bookmarks",
  "publisher": "Wikid82",
  "private": false,
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wikid82/file_bookmarks"
  },
  "engines": {
    "vscode": "^1.132.0"
  },
  "activationEvents": [],
  "main": "extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "file-bookmarks-sidebar",
          "title": "File Bookmarks",
          "icon": "media/bookmark-icon.svg"
        }
      ]
    },
    "views": {
      "file-bookmarks-sidebar": [
        {
          "type": "webview",
          "id": "file-bookmarks-view",
          "name": "My Bookmarks",
          "icon": "media/bookmark-icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild src/extension.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/extension.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "@types/express": "^5.0.6"
  }
}
