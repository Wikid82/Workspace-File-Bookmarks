{
  "name": "workspace-file-bookmarks",
  "displayName": "Workspace File Bookmarks",
  "description": "Bookmark files across multi-repo VS Code workspaces for quick access.",
  "publisher": "Wikid82",
  "private": false,
  "version": "1.4.1",
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "bookmarks",
    "favorites",
    "multi-root",
    "multi-repo",
    "workspace",
    "navigation",
    "quick access",
    "pinned files"
  ],
  "galleryBanner": {
    "color": "#1E293B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wikid82/file_bookmarks"
  },
  "bugs": {
    "url": "https://github.com/Wikid82/file_bookmarks/issues"
  },
  "homepage": "https://github.com/Wikid82/file_bookmarks#readme",
  "engines": {
    "vscode": "^1.132.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.cjs",
  "contributes": {
    "submenus": [
      {
        "id": "workspace-file-bookmarks.addSubmenu",
        "label": "Add to Bookmarks",
        "icon": "$(bookmark)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspace-file-bookmarks-sidebar",
          "title": "Workspace File Bookmarks",
          "icon": "media/bookmark-icon.svg"
        }
      ]
    },
    "views": {
      "workspace-file-bookmarks-sidebar": [
        {
          "id": "workspace-file-bookmarks-view",
          "name": "My Bookmarks",
          "icon": "media/bookmark-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "workspace-file-bookmarks.addBookmark",
        "title": "Add Bookmark",
        "category": "Workspace File Bookmarks",
        "icon": "$(bookmark)"
      },
      {
        "command": "workspace-file-bookmarks.addBookmarkFromExplorer",
        "title": "Add Bookmark",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.addBookmarkToFolder",
        "title": "Add to Folder...",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.removeBookmark",
        "title": "Remove Bookmark",
        "category": "Workspace File Bookmarks",
        "icon": "$(trash)"
      },
      {
        "command": "workspace-file-bookmarks.createFolder",
        "title": "New Bookmark Folder",
        "category": "Workspace File Bookmarks",
        "icon": "$(new-folder)"
      },
      {
        "command": "workspace-file-bookmarks.renameFolder",
        "title": "Rename Folder",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.deleteFolder",
        "title": "Delete Folder",
        "category": "Workspace File Bookmarks",
        "icon": "$(trash)"
      },
      {
        "command": "workspace-file-bookmarks.moveToFolder",
        "title": "Move to Folder...",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.openAllInFolder",
        "title": "Open All Files in Folder",
        "category": "Workspace File Bookmarks",
        "icon": "$(folder-opened)"
      },
      {
        "command": "workspace-file-bookmarks.setViewModeList",
        "title": "View as List",
        "category": "Workspace File Bookmarks",
        "icon": "$(list-flat)"
      },
      {
        "command": "workspace-file-bookmarks.setViewModeTree",
        "title": "View as Tree",
        "category": "Workspace File Bookmarks",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workspace-file-bookmarks.addBookmark",
          "when": "view == workspace-file-bookmarks-view",
          "group": "navigation@1"
        },
        {
          "command": "workspace-file-bookmarks.createFolder",
          "when": "view == workspace-file-bookmarks-view",
          "group": "navigation@2"
        },
        {
          "command": "workspace-file-bookmarks.setViewModeList",
          "when": "view == workspace-file-bookmarks-view && workspace-file-bookmarks.viewMode == tree",
          "group": "navigation@3"
        },
        {
          "command": "workspace-file-bookmarks.setViewModeTree",
          "when": "view == workspace-file-bookmarks-view && workspace-file-bookmarks.viewMode == list",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "workspace-file-bookmarks.removeBookmark",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkItem",
          "group": "inline"
        },
        {
          "command": "workspace-file-bookmarks.moveToFolder",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkItem",
          "group": "1_modification"
        },
        {
          "command": "workspace-file-bookmarks.openAllInFolder",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkFolder",
          "group": "inline@1"
        },
        {
          "command": "workspace-file-bookmarks.deleteFolder",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkFolder",
          "group": "inline@2"
        },
        {
          "command": "workspace-file-bookmarks.renameFolder",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkFolder",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "workspace-file-bookmarks.addBookmark",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "submenu": "workspace-file-bookmarks.addSubmenu",
          "when": "!explorerResourceIsFolder",
          "group": "6_bookmark"
        }
      ],
      "workspace-file-bookmarks.addSubmenu": [
        {
          "command": "workspace-file-bookmarks.addBookmarkFromExplorer",
          "group": "1_add@1"
        },
        {
          "command": "workspace-file-bookmarks.addBookmarkToFolder",
          "group": "1_add@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild extension.ts --bundle --platform=node --format=cjs --sourcemap --external:vscode --outfile=dist/extension.cjs",
    "watch": "esbuild extension.ts --bundle --platform=node --format=cjs --sourcemap --external:vscode --outfile=dist/extension.cjs --watch",
    "vscode:prepublish": "npm run build",
    "package": "bash scripts/rebuild.sh",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
