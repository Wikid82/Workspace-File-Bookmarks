{
  "name": "workspace-file-bookmarks",
  "displayName": "Workspace File Bookmarks",
  "description": "Bookmark files across multi-repo VS Code workspaces for quick access.",
  "publisher": "Wikid82",
  "private": false,
  "version": "1.9.0",
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "bookmarks",
    "favorites",
    "multi-root",
    "multi-repo",
    "workspace",
    "navigation",
    "quick access",
    "pinned files"
  ],
  "galleryBanner": {
    "color": "#1E293B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wikid82/Workspace-File-Bookmarks"
  },
  "bugs": {
    "url": "https://github.com/Wikid82/Workspace-File-Bookmarks/issues"
  },
  "homepage": "https://github.com/Wikid82/Workspace-File-Bookmarks#readme",
  "engines": {
    "vscode": "^1.134.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.cjs",
  "contributes": {
    "submenus": [
      {
        "id": "workspace-file-bookmarks.addSubmenu",
        "label": "Add to Bookmarks",
        "icon": "$(bookmark)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspace-file-bookmarks-sidebar",
          "title": "Workspace File Bookmarks",
          "icon": "media/bookmark-icon.svg"
        }
      ]
    },
    "views": {
      "workspace-file-bookmarks-sidebar": [
        {
          "id": "workspace-file-bookmarks-view",
          "name": "My Bookmarks",
          "icon": "media/bookmark-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "workspace-file-bookmarks.addBookmark",
        "title": "Add Bookmark",
        "category": "Workspace File Bookmarks",
        "icon": "$(bookmark)"
      },
      {
        "command": "workspace-file-bookmarks.addBookmarkFromExplorer",
        "title": "Add Bookmark",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.addBookmarkToFolder",
        "title": "Add to Folder...",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.removeBookmark",
        "title": "Remove Bookmark",
        "category": "Workspace File Bookmarks",
        "icon": "$(trash)"
      },
      {
        "command": "workspace-file-bookmarks.renameBookmark",
        "title": "Rename Bookmark",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.editTags",
        "title": "Edit Tags...",
        "category": "Workspace File Bookmarks",
        "icon": "$(tag)"
      },
      {
        "command": "workspace-file-bookmarks.filterByTag",
        "title": "Filter by Tag...",
        "category": "Workspace File Bookmarks",
        "icon": "$(filter)"
      },
      {
        "command": "workspace-file-bookmarks.clearTagFilter",
        "title": "Clear Tag Filter",
        "category": "Workspace File Bookmarks",
        "icon": "$(clear-all)"
      },
      {
        "command": "workspace-file-bookmarks.filterBookmarks",
        "title": "Filter Bookmarks...",
        "category": "Workspace File Bookmarks",
        "icon": "$(search)"
      },
      {
        "command": "workspace-file-bookmarks.clearSearchFilter",
        "title": "Clear Bookmark Filter",
        "category": "Workspace File Bookmarks",
        "icon": "$(search-stop)"
      },
      {
        "command": "workspace-file-bookmarks.createFolder",
        "title": "New Bookmark Folder",
        "category": "Workspace File Bookmarks",
        "icon": "$(new-folder)"
      },
      {
        "command": "workspace-file-bookmarks.createSubfolder",
        "title": "New Subfolder",
        "category": "Workspace File Bookmarks",
        "icon": "$(new-folder)"
      },
      {
        "command": "workspace-file-bookmarks.moveFolderToParent",
        "title": "Move to Parent Folder...",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.renameFolder",
        "title": "Rename Folder",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.deleteFolder",
        "title": "Delete Folder",
        "category": "Workspace File Bookmarks",
        "icon": "$(trash)"
      },
      {
        "command": "workspace-file-bookmarks.moveToFolder",
        "title": "Move to Folder...",
        "category": "Workspace File Bookmarks"
      },
      {
        "command": "workspace-file-bookmarks.openAllInFolder",
        "title": "Open All Files in Folder",
        "category": "Workspace File Bookmarks",
        "icon": "$(folder-opened)"
      },
      {
        "command": "workspace-file-bookmarks.setViewModeList",
        "title": "View as List",
        "category": "Workspace File Bookmarks",
        "icon": "$(list-flat)"
      },
      {
        "command": "workspace-file-bookmarks.setViewModeTree",
        "title": "View as Tree",
        "category": "Workspace File Bookmarks",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workspace-file-bookmarks.addBookmark",
          "when": "view == workspace-file-bookmarks-view",
          "group": "navigation@1"
        },
        {
          "command": "workspace-file-bookmarks.createFolder",
          "when": "view == workspace-file-bookmarks-view",
          "group": "navigation@2"
        },
        {
          "command": "workspace-file-bookmarks.filterBookmarks",
          "when": "view == workspace-file-bookmarks-view && !workspace-file-bookmarks.searchFilterActive",
          "group": "navigation@3"
        },
        {
          "command": "workspace-file-bookmarks.clearSearchFilter",
          "when": "view == workspace-file-bookmarks-view && workspace-file-bookmarks.searchFilterActive",
          "group": "navigation@3"
        },
        {
          "command": "workspace-file-bookmarks.filterByTag",
          "when": "view == workspace-file-bookmarks-view && !workspace-file-bookmarks.tagFilterActive",
          "group": "navigation@4"
        },
        {
          "command": "workspace-file-bookmarks.clearTagFilter",
          "when": "view == workspace-file-bookmarks-view && workspace-file-bookmarks.tagFilterActive",
          "group": "navigation@4"
        },
        {
          "command": "workspace-file-bookmarks.setViewModeList",
          "when": "view == workspace-file-bookmarks-view && workspace-file-bookmarks.viewMode == tree",
          "group": "navigation@5"
        },
        {
          "command": "workspace-file-bookmarks.setViewModeTree",
          "when": "view == workspace-file-bookmarks-view && workspace-file-bookmarks.viewMode == list",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "workspace-file-bookmarks.removeBookmark",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkItem",
          "group": "inline"
        },
        {
          "command": "workspace-file-bookmarks.renameBookmark",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkItem",
          "group": "1_modification"
        },
        {
          "command": "workspace-file-bookmarks.editTags",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkItem",
          "group": "1_modification"
        },
        {
          "command": "workspace-file-bookmarks.moveToFolder",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkItem",
          "group": "1_modification"
        },
        {
          "command": "workspace-file-bookmarks.openAllInFolder",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkFolder",
          "group": "inline@1"
        },
        {
          "command": "workspace-file-bookmarks.createSubfolder",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkFolder",
          "group": "inline@2"
        },
        {
          "command": "workspace-file-bookmarks.deleteFolder",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkFolder",
          "group": "inline@3"
        },
        {
          "command": "workspace-file-bookmarks.renameFolder",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkFolder",
          "group": "1_modification"
        },
        {
          "command": "workspace-file-bookmarks.moveFolderToParent",
          "when": "view == workspace-file-bookmarks-view && viewItem == bookmarkFolder",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "workspace-file-bookmarks.addBookmark",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "submenu": "workspace-file-bookmarks.addSubmenu",
          "when": "!explorerResourceIsFolder",
          "group": "6_bookmark"
        }
      ],
      "workspace-file-bookmarks.addSubmenu": [
        {
          "command": "workspace-file-bookmarks.addBookmarkFromExplorer",
          "group": "1_add@1"
        },
        {
          "command": "workspace-file-bookmarks.addBookmarkToFolder",
          "group": "1_add@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild extension.ts --bundle --platform=node --format=cjs --sourcemap --external:vscode --outfile=dist/extension.cjs",
    "watch": "esbuild extension.ts --bundle --platform=node --format=cjs --sourcemap --external:vscode --outfile=dist/extension.cjs --watch",
    "vscode:prepublish": "npm run build",
    "postinstall": "lefthook install",
    "package": "bash scripts/rebuild.sh",
    "clean": "rm -rf dist",
    "lint": "npm run lint:types && npm run lint:style",
    "lint:types": "tsc --noEmit",
    "lint:style": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build && esbuild test/e2e/*.test.ts --bundle --outdir=out-e2e --platform=node --format=cjs --external:vscode --sourcemap",
    "test:e2e": "vscode-test"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
